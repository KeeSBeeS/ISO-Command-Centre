# Signature logo uploads: serve images only, never execute scripts.
<FilesMatch "\.(?i:php\d*|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
